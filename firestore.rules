rules_version = '2';

// This app has no Firebase Auth — the teacher-only screens are gated by a
// plain-text password stored inside the "settings" document, checked in the
// browser. That is NOT a real security boundary: anyone who can read/write
// the "app" collection can also read the password or overwrite the data.
// These rules simply scope reads/writes to that one collection so nothing
// else in the project is exposed. For real protection, add Firebase
// Authentication and tighten the "write" rule below to require a signed-in
// teacher account.
service cloud.firestore {
  match /databases/{database}/documents {
    match /app/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
