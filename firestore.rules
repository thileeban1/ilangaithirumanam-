rules_version = '2';

// Three kinds of signed-in Firebase Auth users exist in this app:
// - Admins: accounts YOU create manually in Firebase Console -> Authentication,
//   then list in the "admins" collection (doc id = their auth uid).
// - Members: every visitor who registers a profile automatically gets a
//   Firebase Auth account (synthetic email from their phone + the password
//   they chose), so they can log back in to see their own status, edit
//   their profile, manage their package, and unlock other profiles.
//
// Each profile's identity-revealing fields are split into two separate
// documents so access to them can be granted independently and enforced by
// these rules (not just hidden in the UI):
//   profiles/{id}/private/identity -> { name, photoUrl }   (a "photo unlock")
//   profiles/{id}/private/contact  -> { phone, email }     (a "phone unlock")
// Everything else (age/dob, district, religion, etc. - the "meters") stays
// on the profiles/{id} document itself and is visible to any signed-in
// member once the profile is approved.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lets an admin list every profile's private/identity + private/contact
    // doc in one collectionGroup query (for reviewing registrations and
    // managing packages) without needing to open each profile individually.
    match /{path=**}/private/{doc} {
      allow read: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /counters/{docId} {
      // Used only to atomically hand out sequential 5-digit member IDs at
      // registration time. assignMemberId() runs this inside a transaction,
      // which must read the counter before it can write the next value, so
      // read access can't be "if false" or every registration fails right
      // after the auth account is created (denied mid-transaction) and
      // before the profile document is ever saved.
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /profiles/{profileId} {
      allow read: if isAdmin()
                  || resource.data.status == 'approved'
                  || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.gender is string
                    && request.resource.data.gender.size() > 0;
      // A member may edit their own profile's meters, but never change who
      // owns it or self-approve/reject it; an admin can change anything.
      allow update: if isAdmin()
                    || (request.auth != null
                        && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();

      match /private/{doc} {
        // Direct (non-collectionGroup) reads: the admin rule above already
        // covers admins; this adds the owner (always) and any member who
        // has spent a credit unlocking this specific profile's photo/phone.
        allow read: if isAdmin()
                    || (request.auth != null && get(/databases/$(database)/documents/profiles/$(profileId)).data.ownerUid == request.auth.uid)
                    || (doc == 'identity' && request.auth != null
                        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
                        && profileId in get(/databases/$(database)/documents/members/$(request.auth.uid)).data.unlockedPhotoIds)
                    || (doc == 'contact' && request.auth != null
                        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
                        && profileId in get(/databases/$(database)/documents/members/$(request.auth.uid)).data.unlockedPhoneIds);
        allow write: if isAdmin()
                     || (request.auth != null && get(/databases/$(database)/documents/profiles/$(profileId)).data.ownerUid == request.auth.uid);
      }
    }

    match /members/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Created once at registration with everything zeroed out — a member
      // can never hand themselves quota by writing their own doc.
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.package == null
                    && request.resource.data.photoQuota == 0
                    && request.resource.data.phoneQuota == 0
                    && request.resource.data.photoQuotaUsed == 0
                    && request.resource.data.phoneQuotaUsed == 0;
      // A member can spend their own credits (unlockedPhotoIds/unlockedPhoneIds,
      // photoQuotaUsed/phoneQuotaUsed going up) but can never grant themselves
      // a package or more quota — only an admin can touch those fields, and
      // "used" can only move up to the already-granted total.
      allow update: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['package', 'packageExpiresAt', 'photoQuota', 'phoneQuota'])
                        && request.resource.data.photoQuotaUsed >= resource.data.photoQuotaUsed
                        && request.resource.data.phoneQuotaUsed >= resource.data.phoneQuotaUsed
                        && request.resource.data.photoQuotaUsed <= resource.data.photoQuota
                        && request.resource.data.phoneQuotaUsed <= resource.data.phoneQuota);
      allow delete: if isAdmin();
    }

    match /interests/{interestId} {
      allow create: if request.resource.data.profileId is string
                    && request.resource.data.requesterName is string
                    && request.resource.data.requesterName.size() > 0
                    && request.resource.data.requesterPhone is string
                    && request.resource.data.requesterPhone.size() > 0;
      // Visible to: the admin, whoever sent the request (if logged in when
      // they sent it), and the profile owner it was sent to — nobody else.
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.requesterUid == request.auth.uid)
                  || (request.auth != null && resource.data.recipientUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
