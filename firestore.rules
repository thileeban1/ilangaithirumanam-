rules_version = '2';

// Students never sign in (they only enter an Access Code inside the app),
// so reads on the "app" collection stay public — that is how the student
// screens load grades/subjects/recordings. Writes (adding a grade, a
// student, a recording, changing the school name, etc.) require a signed-in
// Firebase Auth user — only accounts you create yourself in the Firebase
// Console (Authentication -> Users -> Add user) can sign in as a teacher,
// so only people you explicitly grant an account can write data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /app/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
