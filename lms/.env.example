# Copy this file to .env and fill in the values from your LMS's own Firebase
# project (Project settings -> General -> Your apps -> Web app config).
#
# IMPORTANT: This must be a DIFFERENT Firebase project than the matrimony
# website's project, so the two apps never share data or rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
