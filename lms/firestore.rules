rules_version = '2';

// Roles in this LMS:
// - Admin: an account YOU create manually in Firebase Console -> Authentication,
//   then list in the "admins" collection (doc id = their auth uid). Only the
//   admin can create courses, approve teachers, and manage students.
// - Teacher: signs up through the app, picking "ஆசிரியர்" (teacher). Their
//   users/{uid} doc starts with approved=false until the admin approves them
//   and assigns them a course. Only then can they post lessons.
// - Student: signs up through the app, picking "மாணவர்" (student). Approved
//   immediately, can browse courses, self-enroll, and read lessons for the
//   courses they're enrolled in.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function courseTeacherId(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId;
    }

    function isCourseTeacher(courseId) {
      return isSignedIn() && courseTeacherId(courseId) == request.auth.uid;
    }

    function isEnrolled(courseId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)
      );
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Profile doc for every teacher/student account. "list" is separate from
    // "get" so the admin can query the whole collection (Teachers/Students
    // tabs) while a non-admin can still only fetch their own doc directly.
    match /users/{uid} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['teacher', 'student']
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    // Students are usable immediately; teachers wait for admin approval.
                    && request.resource.data.approved == (request.resource.data.role == 'student');
      // Owner may edit their own name/phone, never their own role/approval.
      // Admin may change anything (e.g. approve a teacher).
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.approved == resource.data.approved);
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
                    && request.resource.data.teacherId is string
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0;
      allow update, delete: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if isAdmin() || isCourseTeacher(courseId) || isEnrolled(courseId);
        allow create, update, delete: if isAdmin() || isCourseTeacher(courseId);
      }
    }

    // Doc id is "${studentId}_${courseId}" so a student can't double-enroll.
    match /enrollments/{enrollmentId} {
      allow create: if isSignedIn()
                    && request.resource.data.studentId == request.auth.uid
                    && request.resource.data.courseId is string
                    && enrollmentId == request.auth.uid + '_' + request.resource.data.courseId;
      allow read, delete: if isAdmin()
                    || (isSignedIn() && resource.data.studentId == request.auth.uid)
                    || isCourseTeacher(resource.data.courseId);
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
